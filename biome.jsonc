{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/drizzle/**/*",
      "!vercel.json",
      "!knip.json",
      "!.pnpm-store/**/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "useUniqueElementIds": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["clsx", "cva", "cn"]
          }
        }
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "React": "Import what you use from \"react\" instead of the UMD global."
            }
          }
        },
        "noYodaExpression": "error",
        "useBlockStatements": "error",
        "useConsistentArrayType": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useFilenamingConvention": "error",
        "useForOf": "error",
        "useThrowOnlyError": "error",
        "useAtIndex": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noConsole": "warn"
      }
    }
  },
  "overrides": [
    {
      // Vendored shadcn code keeps its upstream style and gets only the
      // UMD-global check. A rule or domain turned on above needs an "off"
      // here, or it leaks into these files.
      "includes": [
        "src/components/ui/**",
        "src/hooks/use-mobile.ts",
        "src/lib/utils.ts"
      ],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": {
        "domains": { "next": "none", "react": "none" },
        "rules": {
          "preset": "none",
          "correctness": { "noUnusedImports": "off" },
          "nursery": { "useSortedClasses": "off" },
          "performance": { "noBarrelFile": "off", "noReExportAll": "off" },
          "style": {
            "noYodaExpression": "off",
            "useBlockStatements": "off",
            "useConsistentArrayType": "off",
            "useConsistentBuiltinInstantiation": "off",
            "useFilenamingConvention": "off",
            "useForOf": "off",
            "useThrowOnlyError": "off",
            "useAtIndex": "off"
          },
          "suspicious": { "noEmptyBlockStatements": "off", "noConsole": "off" }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
