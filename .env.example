# Copy to .env for local development. See src/env.ts for the schema.
DATABASE_URL="postgresql://zm:zm@127.0.0.1:5432/zm"
# optional: connect over a Unix socket instead of TCP, e.g.
# "/var/run/postgresql/.s.PGSQL.5432". The host and port in DATABASE_URL are
# then ignored, but it still has to be a valid URL
DATABASE_SOCKET_PATH=""
# "true" logs every query
DATABASE_LOG=""

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# the public URL of the app; on Vercel VERCEL_URL is used when this is empty.
# to test `pnpm dev` from another device on the LAN, set it to the LAN URL
# (e.g. http://192.168.0.50:3000) so the dev server also serves that host
BETTER_AUTH_URL="http://localhost:3000"

# at least 16 chars; sent as "Authorization: Bearer ..." to the cron routes
CRON_SECRET=""

# "today" for overdue checks, the cron jobs, the planned horizon and imports
APP_TIMEZONE="Europe/Kyiv"
TRANSACTIONS_PAGINATION_LIMIT=50

# Optional SMTP (TLS on the given host/port; no provider presets)
MAIL_HOST=""
MAIL_PORT=465
MAIL_USERNAME=""
MAIL_PASSWORD=""
# defaults to MAIL_USERNAME
MAIL_FROM=""

# Optional Sentry
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENV=""
