# Env for `pnpm test`, loaded by vitest.config.ts. Committed on purpose: it holds
# no secrets and points at the throwaway database from docker-compose.test.yml.
# Variables already present in the environment win over this file, so CI can
# override DATABASE_URL to point at its own postgres service.

NODE_ENV=test

# idle_timeout lets postgres-js close sockets so worker processes can exit.
DATABASE_URL="postgresql://zm:zm@127.0.0.1:5433/zm_test?idle_timeout=2"

BETTER_AUTH_SECRET="test-secret-tests-never-sign-a-real-session-000"
BETTER_AUTH_URL="http://localhost:3000"

# Deliberately tiny so pagination tests only need a handful of rows.
TRANSACTIONS_PAGINATION_LIMIT=3

CRON_SECRET="test-cron-secret-0123456789"
APP_TIMEZONE="Europe/Kyiv"
