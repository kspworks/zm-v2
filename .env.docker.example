# Copy to .env.docker and fill in. WARNING: the Postgres password below is
# the public example from docker-compose.yml. Change it in BOTH files before
# the instance is reachable from anywhere.
DATABASE_URL="postgresql://zm:change-me-this-password-is-public@postgres:5432/zm"

# openssl rand -base64 32
BETTER_AUTH_SECRET="GENERATE WITH openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3333"

# Required, at least 16 chars: without it every cron request is refused.
# openssl rand -hex 24
CRON_SECRET="GENERATE WITH openssl rand -hex 24"

APP_TIMEZONE="Europe/Kyiv"
TRANSACTIONS_PAGINATION_LIMIT=50

# Optional: email (insufficient-funds alerts, "forgot password")
MAIL_HOST=""
MAIL_PORT=465
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=""

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENV="production"
