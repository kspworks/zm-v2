{
  "name": "zm",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "email": "email dev --port 3001",
    "build": "export NEXT_PUBLIC_BUILD_ID=${NEXT_PUBLIC_BUILD_ID:-$(date +%y.%-m.%-d)} && NEXT_TELEMETRY_DISABLED=1 next build",
    "build:selfhosted": "pnpm run build && rm -rf dist && { [ ! -d public ] || cp -r public .next/standalone/; } && cp -r .next/static .next/standalone/.next/ && mv .next/standalone dist",
    "smoke": "./smoke-standalone.sh",
    "vercel-build": "pnpm run build && pnpm run db:migrate",
    "start": "next start",
    "typecheck": "SKIP_ENV_VALIDATION=1 next typegen && tsc --noEmit",
    "lint:ci": "biome ci --colors=off --log-kind=compact .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "migrate:v1": "SKIP_ENV_VALIDATION=1 tsx --import ./scripts/stub-server-only.mjs scripts/migrate-from-v1.ts",
    "test": "TZ=UTC vitest run",
    "test:tz": "TZ=UTC APP_TIMEZONE=Pacific/Kiritimati vitest run tests/unit",
    "test:watch": "TZ=UTC vitest",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:db": "tsx e2e/setup-db.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "knip": "SKIP_ENV_VALIDATION=1 knip",
    "check-updates": "npm-check-updates"
  },
  "engines": {
    "node": "^24.14.1",
    "pnpm": ">=12.4.2"
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/nextjs": "^11.1.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.12",
    "nuqs": "^2.10.1",
    "otpauth": "^9.5.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@react-email/ui": "^6.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.38.0",
    "npm-check-updates": "^23.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
